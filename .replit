modules = ["nodejs-20", "bash", "web", "python-3.12", "postgresql-16"]

[nix]
channel = "stable-25_05"
packages = ["redis"]

[agent]
expertMode = true

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "SINNA investor MVP"

[[workflows.workflow]]
name = "SINNA investor MVP"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/run-investor-mvp-dev.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
