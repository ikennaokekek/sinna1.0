{
  "name": "@sinna/api",
  "version": "0.0.1",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "NODE_OPTIONS='--max-old-space-size=2048' npx tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "migrate": "node dist/scripts/migrate.js",
    "migrate:status": "pnpm migrate status",
    "migrate:verify": "pnpm migrate verify",
    "migrate:baseline": "pnpm migrate baseline",
    "migrate:apply": "pnpm migrate apply",
    "test:migrate:integration": "vitest run src/lib/migrationLedger.integration.test.ts",
    "seed": "node dist/scripts/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1127.0",
    "@aws-sdk/s3-request-presigner": "3.1127.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^3.0.1",
    "@sentry/node": "10.17.0",
    "@sinna/types": "workspace:*",
    "bullmq": "^4.18.3",
    "fastify": "^4.27.2",
    "fastify-raw-body": "^4.3.0",
    "ioredis": "^5.7.0",
    "pg": "^8.12.0",
    "rate-limiter-flexible": "^5.0.1",
    "stripe": "^14.25.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.8.6",
    "@types/pg": "^8.15.5",
    "tsx": "4.23.13",
    "typescript": "^5.2.2",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "overrides": {}
  }
}
