# SINNA Core rebuild manifest. Replace every <...> value in your secret store;
# do not commit a populated .env file. See docs/ENVIRONMENT_VARIABLES.md.

# Runtime: required in production by validation
NODE_ENV=<development|production|test>
PORT=<PORT>
DATABASE_URL=<POSTGRES_CONNECTION_URL>
REDIS_URL=<REDIS_CONNECTION_URL>
R2_ACCOUNT_ID=<OBJECT_STORAGE_ACCOUNT_ID>
R2_ACCESS_KEY_ID=<OBJECT_STORAGE_ACCESS_KEY_ID>
R2_SECRET_ACCESS_KEY=<OBJECT_STORAGE_SECRET_ACCESS_KEY>
R2_BUCKET=<OBJECT_STORAGE_BUCKET>
CLOUDINARY_URL=<MEDIA_TRANSFORM_CONNECTION_URL>

# Runtime: at least one is required in production by validation
ASSEMBLYAI_API_KEY=<CAPTION_PROVIDER_API_KEY>
OPENAI_API_KEY=<AI_PROVIDER_API_KEY>
OPEN_ROUTER_QWEN_KEY=<VISION_INSTRUCTION_PROVIDER_API_KEY>

# Runtime URLs and access controls
BASE_URL=<API_BASE_URL>
BASE_URL_PUBLIC=<PUBLIC_API_BASE_URL>
BASE_URL_PRIVATE=<PRIVATE_API_BASE_URL>
CORS_ORIGINS=<COMMA_SEPARATED_ALLOWED_ORIGINS>
TRUST_PROXIES=<0_OR_1>
TRUSTED_CIDRS=<COMMA_SEPARATED_CIDRS>
STATUS_PAGE_URL=<STATUS_PAGE_URL>
SENTRY_DSN=<ERROR_MONITORING_DSN>

# Core-to-onboarding synchronization
REPLIT_SYNC_SECRET=<ONBOARDING_SYNC_SHARED_SECRET>

# Billing: configure together when Core creates checkout sessions or verifies webhooks
STRIPE_SECRET_KEY=<PAYMENT_PROVIDER_SECRET_KEY>
STRIPE_WEBHOOK_SECRET=<PAYMENT_WEBHOOK_SIGNING_SECRET>
STRIPE_STANDARD_PRICE_ID=<STANDARD_SUBSCRIPTION_PRICE_ID>
STRIPE_SECRET_KEY_LIVE=<PRODUCTION_PAYMENT_PROVIDER_SECRET_KEY>
STRIPE_WEBHOOK_SECRET_LIVE=<PRODUCTION_PAYMENT_WEBHOOK_SIGNING_SECRET>
GRACE_DAYS=<INTEGER_DAYS>

# Notifications
NOTIFY_FROM_EMAIL=<NOTIFICATION_FROM_EMAIL>
NOTIFY_FALLBACK_EMAIL=<OPERATIONS_NOTIFICATION_EMAIL>
RESEND_API_KEY=<EMAIL_PROVIDER_PRIMARY_API_KEY>
SENDGRID_API_KEY=<EMAIL_PROVIDER_FALLBACK_API_KEY>

# Admin and seed operations
ADMIN_ENDPOINTS_ENABLED=<0_OR_1>
ADMIN_API_KEY=<ADMIN_ENDPOINT_SHARED_KEY>
SEED_API_KEY_SECRET=<SEED_DERIVATION_SECRET>
TENANT_NAME=<SEED_TENANT_NAME>
PLAN=<SEED_PLAN_NAME>
JWT_SECRET=<LEGACY_TEST_JWT_SECRET>

# Test-only webhook bypass: effective only when NODE_ENV=test
STRIPE_TESTING=<true|false>
VITEST=<true>
TEST_MIGRATION_DATABASE_URL=<DISPOSABLE_POSTGRES_CONNECTION_URL>
CONFIRM_DISPOSABLE_MIGRATION_DATABASE=<YES>
HOST=<TEST_TCP_HOST>
CI_TEST_API_KEY=<LOCAL_INTEGRATION_TENANT_API_KEY>
RUN_E2E=<0_OR_1>
SINNA_IT_PG_PORT=<LOCAL_POSTGRES_PORT>
SINNA_IT_RD_PORT=<LOCAL_REDIS_PORT>
SINNA_LOCAL_PG_PORT=<LOCAL_POSTGRES_PORT>
SINNA_LOCAL_RD_PORT=<LOCAL_REDIS_PORT>

# Smoke, manual, and API verification scripts
API_BASE_URL=<TARGET_API_BASE_URL>
E2E_BASE_URL=<TARGET_API_BASE_URL>
STAGING_E2E_BASE_URL=<TARGET_API_BASE_URL>
API_KEY=<TENANT_API_KEY>
TEST_API_KEY=<TENANT_API_KEY>
TEST_EMAIL=<TEST_RECIPIENT_EMAIL>
TEST_VIDEO_URL=<PUBLIC_TEST_VIDEO_URL>
PRESET_ID=<PRESET_ID>
PRESETS_CSV=<COMMA_SEPARATED_PRESET_IDS>
SMOKE_POLL_INTERVAL_SEC=<POSITIVE_INTEGER_SECONDS>
SMOKE_POLL_TIMEOUT_SEC=<POSITIVE_INTEGER_SECONDS>
SKIP_BILLING=<0_OR_1>
SKIP_JOBS=<0_OR_1>
WEBHOOK_URL=<STRIPE_WEBHOOK_ENDPOINT_URL>

# Payment-provider utility scripts
STRIPE_LIVE_SECRET_KEY=<PRODUCTION_PAYMENT_PROVIDER_SECRET_KEY>
STRIPE_LIVE_PRICE_ID=<PRODUCTION_SUBSCRIPTION_PRICE_ID>

# Operational watchdog (provider-neutral host API credentials)
RENDER_API_KEY=<HOST_CONTROL_PLANE_API_KEY>
RENDER_SERVICE_ID=<HOST_SERVICE_ID>
RENDER_API_SERVICE_ID=<HOST_SERVICE_ID>
RENDER_SERVICE=<HOST_SERVICE_ID>
render_service_id=<HOST_SERVICE_ID>
SLACK_WEBHOOK_URL=<OPERATIONS_ALERT_WEBHOOK_URL>