# Application
NODE_ENV=development
PORT=4000
BASE_URL=http://localhost:4000
BASE_URL_PUBLIC=http://localhost:4000
BASE_URL_PRIVATE=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUST_PROXIES=0
TRUSTED_CIDRS=
STATUS_PAGE_URL=https://status.sinna.site

# Database
DATABASE_URL=postgresql://__DB_USER__:__DB_PASSWORD__@__DB_HOST__:__DB_PORT__/__DB_NAME__
REDIS_URL=redis://__REDIS_HOST__:__REDIS_PORT__
RUN_MIGRATIONS_ON_BOOT=0
SEED_API_KEY_SECRET=__SEED_API_KEY_SECRET__

# Storage
R2_ACCOUNT_ID=__R2_ACCOUNT_ID__
R2_ACCESS_KEY_ID=__R2_ACCESS_KEY_ID__
R2_SECRET_ACCESS_KEY=__R2_SECRET_ACCESS_KEY__
R2_BUCKET=__R2_BUCKET__
CLOUDINARY_URL=cloudinary://__API_KEY__:__API_SECRET__@__CLOUD_NAME__

# AI / external services
ASSEMBLYAI_API_KEY=__ASSEMBLYAI_API_KEY__
OPENAI_API_KEY=__OPENAI_API_KEY__
OPEN_ROUTER_QWEN_KEY=__OPEN_ROUTER_QWEN_KEY__
PROVIDER_CAPTIONS=assemblyai_realtime
PROVIDER_TTS=openai
PROVIDER_CAPTIONS_VOD=whisper

# Authentication / security
JWT_SECRET=__JWT_SECRET__
API_RATE_LIMIT=100
ADMIN_API_KEY=__ADMIN_API_KEY__
WEBHOOK_SIGNING_SECRET=__WEBHOOK_SIGNING_SECRET__
WEBHOOK_HMAC_HEADER=x-webhook-signature
REPLIT_SYNC_SECRET=__REPLIT_SYNC_SECRET__
REPLIT_IP_ALLOWLIST=
ENABLE_RENDER_CHECKOUT_HANDLER=false

# Billing / payments
STRIPE_SECRET_KEY=__STRIPE_SECRET_KEY__
STRIPE_WEBHOOK_SECRET=__STRIPE_WEBHOOK_SECRET__
STRIPE_STANDARD_PRICE_ID=__STRIPE_STANDARD_PRICE_ID__
GRACE_DAYS=7

# Email / notifications
NOTIFY_FROM_EMAIL=noreply@sinna.site
NOTIFY_FALLBACK_EMAIL=ops@example.com
RESEND_API_KEY=__RESEND_API_KEY__
SENDGRID_API_KEY=__SENDGRID_API_KEY__

# Monitoring / observability
SENTRY_DSN=https://__PUBLIC_KEY__@oXXXX.ingest.sentry.io/XXXXX
GRAFANA_PROM_PUSH_URL=

# Feature flags
FEATURE_REALTIME=0
GPU_PROVIDER=none

# Testing
API_KEY=__TEST_API_KEY__
TEST_API_KEY=__TEST_API_KEY__
E2E_BASE_URL=http://localhost:4000

# Deployment compatibility
BASE_URL_PUBLIC=https://example.com
BASE_URL_PRIVATE=https://example.com

